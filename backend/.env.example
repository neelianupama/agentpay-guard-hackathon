# AgentPay Guard backend configuration template.
# Copy to backend/.env and fill in locally. Never commit backend/.env or real credentials.
# Leave values blank here.

# --- PayPal (Sandbox only) ---
# REST app credentials from https://developer.paypal.com (Sandbox app). Server-side only;
# never put them in frontend code.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Leave empty for the default. Only https://api-m.sandbox.paypal.com is accepted; any Live
# PayPal URL or other host stops the backend at startup with a configuration error.
PAYPAL_BASE_URL=
# Timeout in seconds for each PayPal HTTP request. Empty = 15. Allowed range: 1-60.
PAYPAL_TIMEOUT_SECONDS=

# --- Human reviewer protection ---
# Shared secret required for approval operations. At least 32 characters; approvals stay
# disabled while it is missing or shorter. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REVIEWER_TOKEN=

# --- Groq (natural-language intent parsing) ---
GROQ_API_KEY=
GROQ_MODEL=

# --- Elastic (audit trail) ---
# Elasticsearch REST endpoint, e.g. your Elastic Cloud deployment URL. https only (http is
# accepted only for localhost); no credentials, query or fragment in the URL. Leave both
# empty to run without Elastic: audit events are then held only in backend memory (not
# durable) and the audit API reports a degraded state. Payments never depend on Elastic.
ELASTIC_URL=
# API key (sent as "Authorization: ApiKey ..."). Grant it only create_index, create_doc,
# read and view_index_metadata on the audit index. Never logged or returned.
ELASTIC_API_KEY=
# Audit index name. Empty = agentpay-audit-events. Lowercase letters, digits, '.', '_', '-'.
ELASTIC_INDEX=
# Timeout in seconds for each Elastic request. Empty = 5. Allowed range: 1-30.
ELASTIC_TIMEOUT_SECONDS=

# --- CORS ---
FRONTEND_URL=http://localhost:5173
